{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgT3TgWSFdwtyYrv3Z6Yv","type":"message","role":"assistant","content":[{"type":"text","text":"The six tokenizers trained in seconds, and my FREQ trainer matches HuggingFace's BPE trainer exactly (100% merge overlap). Next I'm encoding the corpora and computing the tokenizer metrics."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2495,"cache_read_input_tokens":87510,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2495},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d03f1b7b-1654-4a7a-b5d1-37b77a3f06fc","uuid":"4178423f-0c88-4bdf-98ac-c9d3254841aa","timestamp":"2026-10-27T16:17:45.878Z","request_id":"req_011CgT3TgAME1jfT7ZcMY3qi"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgT3TgWSFdwtyYrv3Z6Yv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Xg6bDPLyjfcp6TE2E3eL7n","name":"Write","input":{"file_path":"/data/summereunann/neurico-workspaces/tokenizer_merge_order_20261027_120001_ef56gh78/src/encode_and_intrinsics.py","content":"\"\"\"Encode LM/eval corpora with every tokenizer (uint16 .npy) and compute intrinsic tokenizer metrics.\n\nDocuments are joined with a single EOS-like separator id (= vocab_size, outside the BPE vocabulary).\nIntrinsic metrics (on held-out eval text):\n  bytes_per_token, tokens_per_word, renyi_eff_2.5 (Zouhar et al. 2023), vocab_used_frac (on 20 MB of LM train),\n  top1k_single_frac (share of the 1000 most frequent eval words encoded as ONE token),\n  seg_agree_freq (share of eval word tokens segmented identically to FREQ).\n\"\"\"\nimport json\nimport re\nfrom collections import Counter\nfrom pathlib import Path\n\nimport numpy as np\nfrom tokenizers import Tokenizer\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"datasets\" / \"processed\"\nTOK = ROOT / \"results\" / \"tokenizers\"\nENC = ROOT / \"results\" / \"encoded\"\nNAMES = [\"FREQ\", \"DOMAIN\", \"RAND_LEARN\", \"REV_LEARN\", \"RAND_ORDER\", \"REV_ORDER\"]\n\n\ndef encode_file(tok, path):\n    docs = open(path, encoding=\"utf-8\").read().split(\"\\n\\n\")\n    sep = tok.get_vocab_size()\n    out = []\n    for i in range(0, len(docs), 2000):\n        for e in tok.encode_batch(docs[i:i + 2000]):\n            out.extend(e.ids)\n            out.append(sep)\n    return np.array(out, dtype=np.uint16), sum(len(d.encode()) + 1 for d in docs)\n\n\ndef renyi_eff(counts, alpha=2.5):\n    p = np.array(list(counts.values()), dtype=float)\n    p /= p.sum()\n    h_a = np.log(np.sum(p ** alpha)) / (1 - alpha)\n    return float(h_a / np.log(len(p)))\n\n\ndef main():\n    ENC.mkdir(parents=True, exist_ok=True)\n    toks = {n: Tokenizer.from_file(str(TOK / f\"{n}.json\")) for n in NAMES}\n    report = {}\n    pre = toks[\"FREQ\"].pre_tokenizer\n    words = {}\n    for split in [\"general\", \"domain\"]:\n        text = open(DATA / f\"eval_{split}.txt\", encoding=\"utf-8\").read()\n        ws = [w for w, _ in pre.pre_tokenize_str(text)]\n        words[split] = ws\n    freq_seg = {}\n    for n, tok in toks.items():\n        r = {\"vocab_size\": tok.get_vocab_size()}\n        for split in [\"lm_train\", \"eval_general\", \"eval_domain\"]:\n            path = DATA / f\"{split}.txt\"\n            f = ENC / f\"{n}.{split}.npy\"\n            if not f.exists():\n                ids, nbytes = encode_file(tok, path)\n                np.save(f, ids)\n                json.dump({\"n_bytes\": nbytes, \"n_tokens\": int(len(ids))}, open(ENC / f\"{n}.{split}.json\", \"w\"))\n            meta = json.load(open(ENC / f\"{n}.{split}.json\"))\n            r[f\"{split}_tokens\"] = meta[\"n_tokens\"]\n            r[f\"{split}_bytes_per_token\"] = meta[\"n_bytes\"] / meta[\"n_tokens\"]\n        ids = np.load(ENC / f\"{n}.lm_train.npy\")[:5_000_000]\n        r[\"vocab_used_frac_5Mtok\"] = float(len(np.unique(ids)) - 1) / tok.get_vocab_size()\n        for split in [\"general\", \"domain\"]:\n            ws = words[split]\n            uniq = list(Counter(ws))\n            seg = {w: tuple(tok.model.tokenize(w)[i].value for i in range(len(tok.model.tokenize(w)))) for w in uniq}\n            if n == \"FREQ\":\n                freq_seg[split] = seg\n            cnt = Counter(ws)\n            ntok = sum(len(seg[w]) * c for w, c in cnt.items())\n            r[f\"{split}_tokens_per_word\"] = ntok / len(ws)\n            alpha = [w for w, _ in cnt.most_common() if re.fullmatch(r\"Ġ?[A-Za-z]+\", w)][:1000]\n            r[f\"{split}_top1k_single_frac\"] = float(np.mean([len(seg[w]) == 1 for w in alpha]))\n            r[f\"{split}_top1k_tokens_per_word\"] = float(np.mean([len(seg[w]) for w in alpha]))\n            r[f\"{split}_seg_agree_freq\"] = sum(c for w, c in cnt.items() if seg[w] == freq_seg[split][w]) / len(ws)\n            uc = Counter()\n            for w, c in cnt.items():\n                for t in seg[w]:\n                    uc[t] += c\n            r[f\"{split}_renyi_eff_2.5\"] = renyi_eff(uc)\n            if n in (\"FREQ\", \"DOMAIN\", \"REV_ORDER\", \"RAND_ORDER\", \"REV_LEARN\", \"RAND_LEARN\"):\n                ex = [\"Ġthe\", \"Ġbecause\", \"Ġfootball\", \"Ġrandomized\", \"Ġpatients\", \"Ġhypertension\",\n                      \"Ġinternational\", \"Ġplacebo\"]\n                r[\"examples\"] = {w: [t for t in (x.value for x in tok.model.tokenize(w))] for w in ex}\n        report[n] = r\n        print(n, {k: (round(v, 3) if isinstance(v, float) else v) for k, v in r.items() if k != \"examples\"},\n              flush=True)\n        print(\"   \", r[\"examples\"])\n    json.dump(report, open(ROOT / \"results\" / \"intrinsics.json\", \"w\"), indent=1)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2495,"cache_read_input_tokens":87510,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2495},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d03f1b7b-1654-4a7a-b5d1-37b77a3f06fc","uuid":"fbd6afe7-1452-492a-8afa-f501477b127a","timestamp":"2026-10-27T16:18:02.690Z","request_id":"req_011CgT3TgAME1jfT7ZcMY3qi","wire_tool_inputs":{"toolu_01Xg6bDPLyjfcp6TE2E3eL7n":{"file_path":"/data/summereunann/neurico-workspaces/tokenizer_merge_order_20261027_120001_ef56gh78/src/encode_and_intrinsics.py","content":"\"\"\"Encode LM/eval corpora with every tokenizer (uint16 .npy) and compute intrinsic tokenizer metrics.\n\nDocuments are joined with a single EOS-like separator id (= vocab_size, outside the BPE vocabulary).\nIntrinsic metrics (on held-out eval text):\n  bytes_per_token, tokens_per_word, renyi_eff_2.5 (Zouhar et al. 2023), vocab_used_frac (on 20 MB of LM train),\n  top1k_single_frac (share of the 1000 most frequent eval words encoded as ONE token),\n  seg_agree_freq (share of eval word tokens segmented identically to FREQ).\n\"\"\"\nimport json\nimport re\nfrom collections import Counter\nfrom pathlib import Path\n\nimport numpy as np\nfrom tokenizers import Tokenizer\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"datasets\" / \"processed\"\nTOK = ROOT / \"results\" / \"tokenizers\"\nENC = ROOT / \"results\" / \"encoded\"\nNAMES = [\"FREQ\", \"DOMAIN\", \"RAND_LEARN\", \"REV_LEARN\", \"RAND_ORDER\", \"REV_ORDER\"]\n\n\ndef encode_file(tok, path):\n    docs = open(path, encoding=\"utf-8\").read().split(\"\\n\\n\")\n    sep = tok.get_vocab_size()\n    out = []\n    for i in range(0, len(docs), 2000):\n        for e in tok.encode_batch(docs[i:i + 2000]):\n            out.extend(e.ids)\n            out.append(sep)\n    return np.array(out, dtype=np.uint16), sum(len(d.encode()) + 1 for d in docs)\n\n\ndef renyi_eff(counts, alpha=2.5):\n    p = np.array(list(counts.values()), dtype=float)\n    p /= p.sum()\n    h_a = np.log(np.sum(p ** alpha)) / (1 - alpha)\n    return float(h_a / np.log(len(p)))\n\n\ndef main():\n    ENC.mkdir(parents=True, exist_ok=True)\n    toks = {n: Tokenizer.from_file(str(TOK / f\"{n}.json\")) for n in NAMES}\n    report = {}\n    pre = toks[\"FREQ\"].pre_tokenizer\n    words = {}\n    for split in [\"general\", \"domain\"]:\n        text = open(DATA / f\"eval_{split}.txt\", encoding=\"utf-8\").read()\n        ws = [w for w, _ in pre.pre_tokenize_str(text)]\n        words[split] = ws\n    freq_seg = {}\n    for n, tok in toks.items():\n        r = {\"vocab_size\": tok.get_vocab_size()}\n        for split in [\"lm_train\", \"eval_general\", \"eval_domain\"]:\n            path = DATA / f\"{split}.txt\"\n            f = ENC / f\"{n}.{split}.npy\"\n            if not f.exists():\n                ids, nbytes = encode_file(tok, path)\n                np.save(f, ids)\n                json.dump({\"n_bytes\": nbytes, \"n_tokens\": int(len(ids))}, open(ENC / f\"{n}.{split}.json\", \"w\"))\n            meta = json.load(open(ENC / f\"{n}.{split}.json\"))\n            r[f\"{split}_tokens\"] = meta[\"n_tokens\"]\n            r[f\"{split}_bytes_per_token\"] = meta[\"n_bytes\"] / meta[\"n_tokens\"]\n        ids = np.load(ENC / f\"{n}.lm_train.npy\")[:5_000_000]\n        r[\"vocab_used_frac_5Mtok\"] = float(len(np.unique(ids)) - 1) / tok.get_vocab_size()\n        for split in [\"general\", \"domain\"]:\n            ws = words[split]\n            uniq = list(Counter(ws))\n            seg = {w: tuple(tok.model.tokenize(w)[i].value for i in range(len(tok.model.tokenize(w)))) for w in uniq}\n            if n == \"FREQ\":\n                freq_seg[split] = seg\n            cnt = Counter(ws)\n            ntok = sum(len(seg[w]) * c for w, c in cnt.items())\n            r[f\"{split}_tokens_per_word\"] = ntok / len(ws)\n            alpha = [w for w, _ in cnt.most_common() if re.fullmatch(r\"Ġ?[A-Za-z]+\", w)][:1000]\n            r[f\"{split}_top1k_single_frac\"] = float(np.mean([len(seg[w]) == 1 for w in alpha]))\n            r[f\"{split}_top1k_tokens_per_word\"] = float(np.mean([len(seg[w]) for w in alpha]))\n            r[f\"{split}_seg_agree_freq\"] = sum(c for w, c in cnt.items() if seg[w] == freq_seg[split][w]) / len(ws)\n            uc = Counter()\n            for w, c in cnt.items():\n                for t in seg[w]:\n                    uc[t] += c\n            r[f\"{split}_renyi_eff_2.5\"] = renyi_eff(uc)\n            if n in (\"FREQ\", \"DOMAIN\", \"REV_ORDER\", \"RAND_ORDER\", \"REV_LEARN\", \"RAND_LEARN\"):\n                ex = [\"Ġthe\", \"Ġbecause\", \"Ġfootball\", \"Ġrandomized\", \"Ġpatients\", \"Ġhypertension\",\n                      \"Ġinternational\", \"Ġplacebo\"]\n                r[\"examples\"] = {w: [t for t in (x.value for x in tok.model.tokenize(w))] for w in ex}\n        report[n] = r\n        print(n, {k: (round(v, 3) if isinstance(v, float) else v) for k, v in r.items() if k != \"examples\"},\n              flush=True)\n        print(\"   \", r[\"examples\"])\n    json.dump(report, open(ROOT / \"results\" / \"intrinsics.json\", \"w\"), indent=1)\n\n\nif __name__ == \"__main__\":\n    main()\n"}}}
