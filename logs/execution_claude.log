nning.items()):\n            if p.poll() is not None:\n                del running[j]\n                ok = jobs[j][\"marker\"].exists()\n                print(time.strftime(\"%H:%M:%S\"), \"finished\" if ok else f\"FAILED rc={p.returncode}\", jobs[j][\"cmd\"],\n                      flush=True)\n        pending = [i for i, j in enumerate(jobs) if not j[\"marker\"].exists() and i not in running and j[\"tries\"] < 3]\n        if not pending and not running:\n            print(\"all done\", flush=True)\n            return\n        if pending and len(running) < max_running and time.time() - last > LAUNCH_GAP:\n            fm = free_mem()\n            g = max(fm, key=fm.get)\n            i = pending[0]\n            if fm[g] >= jobs[i][\"need\"] + 1.0:\n                jobs[i][\"tries\"] += 1\n                log = ROOT / \"logs\" / \"queue\" / (Path(jobs[i][\"marker\"]).parent.name + f\".try{jobs[i]['tries']}.log\")\n                log.parent.mkdir(parents=True, exist_ok=True)\n                running[i] = subprocess.Popen(jobs[i][\"cmd\"], shell=True, cwd=ROOT, stdout=open(log, \"w\"),\n                                              stderr=subprocess.STDOUT, env=dict(env, CUDA_VISIBLE_DEVICES=str(g)))\n                print(time.strftime(\"%H:%M:%S\"), f\"launched on GPU{g} ({fm[g]:.1f} GB free):\", jobs[i][\"cmd\"],\n                      flush=True)\n                last = time.time()\n        time.sleep(5)\n\n\nif __name__ == \"__main__\":\n    main(sys.argv[1], int(sys.argv[2]) if len(sys.argv) > 2 else 8)\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01QEGup4j6eeDVtN7QajXhrv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
