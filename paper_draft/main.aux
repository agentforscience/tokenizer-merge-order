\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Tokenizer intrinsics on held-out general / biomedical text. ``Top-1k whole'' is the share of the 1,000 most frequent words encoded as a single token. ``Vocab used'' is the share of the 8,192 entries that occur in 5M encoded tokens. ``Agree'' is segmentation agreement with \textsc  {Freq}\xspace  on general text. The application-order tokenizers share \textsc  {Freq}\xspace  's vocabulary but use only 21--41\% of it. Best value per column in \textbf  {bold}.\relax }}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:intrinsics}{{2}{6}{Tokenizer intrinsics on held-out general / biomedical text. ``Top-1k whole'' is the share of the 1,000 most frequent words encoded as a single token. ``Vocab used'' is the share of the 8,192 entries that occur in 5M encoded tokens. ``Agree'' is segmentation agreement with \freq on general text. The application-order tokenizers share \freq 's vocabulary but use only 21--41\% of it. Best value per column in \textbf {bold}.\relax }{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Held-out bits-per-byte (lower is better; mean of 2 pre-training seeds) and relative change against \textsc  {Freq}\xspace  with 95\% paired-bootstrap CIs. All 10 comparisons are significant after Holm correction ($p_{\text  {Holm}} = 0.032$ for \textsc  {Domain}\xspace  on general text, $0.0025$ for all others). The seed standard deviation is at most 0.002 on general text and 0.016 on biomedical text. Best value per column in \textbf  {bold}.\relax }}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:bpb}{{3}{6}{Held-out bits-per-byte (lower is better; mean of 2 pre-training seeds) and relative change against \freq with 95\% paired-bootstrap CIs. All 10 comparisons are significant after Holm correction ($p_{\text {Holm}} = 0.032$ for \domain on general text, $0.0025$ for all others). The seed standard deviation is at most 0.002 on general text and 0.016 on biomedical text. Best value per column in \textbf {bold}.\relax }{table.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Merge order matters for language modeling}{6}{subsection.4.2}\protected@file@percent }
\newlabel{sec:lm}{{4.2}{6}{Merge order matters for language modeling}{subsection.4.2}{}}
\citation{zouhar2023tokenization}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Compression predicts language-modeling quality. Each point is one tokenizer (mean of 2 seeds; labels use underscores, e.g.,\xspace  \texttt  {REV\_LEARN} is \textsc  {Rev-Learn}\xspace  ). {\em  (Left)}On general text, the rank of bytes-per-token matches the rank of BPB\xspace  exactly (Spearman $\rho =-1.0$, exact $p=0.003$). {\em  (Right)}On biomedical text the relation is nearly monotone ($\rho =-0.94$, $p=0.005$); \textsc  {Rand-Learn}\xspace  and \textsc  {Rand-Order}\xspace  swap places, and \textsc  {Domain}\xspace  overtakes \textsc  {Freq}\xspace  by compressing better.\relax }}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:compression}{{2}{7}{Compression predicts language-modeling quality. Each point is one tokenizer (mean of 2 seeds; labels use underscores, \eg \texttt {REV\_LEARN} is \revlearn ). \figleft On general text, the rank of bytes-per-token matches the rank of \bpb exactly (Spearman $\rho =-1.0$, exact $p=0.003$). \figright On biomedical text the relation is nearly monotone ($\rho =-0.94$, $p=0.005$); \randlearn and \randorder swap places, and \domain overtakes \freq by compressing better.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Compression explains the language-modeling gap}{7}{subsection.4.3}\protected@file@percent }
\newlabel{sec:mechanism}{{4.3}{7}{Compression explains the language-modeling gap}{subsection.4.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Merge order does not affect fine-tuned classification}{7}{subsection.4.4}\protected@file@percent }
\newlabel{sec:ft}{{4.4}{7}{Merge order does not affect fine-tuned classification}{subsection.4.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Fine-tuned accuracy (\%, mean $\pm $ sd over 4 runs) and relative change against \textsc  {Freq}\xspace  with 95\% paired-bootstrap CIs over test items. None of the 15 comparisons is significant (raw $p \ge 0.08$; Holm-adjusted $p = 1.0$). Best mean per task in \textbf  {bold}. Macro-F1 gives the same picture (table\nobreakspace  {}\ref  {tab:f1}).\relax }}{8}{table.caption.7}\protected@file@percent }
\newlabel{tab:finetune}{{4}{8}{Fine-tuned accuracy (\%, mean $\pm $ sd over 4 runs) and relative change against \freq with 95\% paired-bootstrap CIs over test items. None of the 15 comparisons is significant (raw $p \ge 0.08$; Holm-adjusted $p = 1.0$). Best mean per task in \textbf {bold}. Macro-F1 gives the same picture (\tabref {tab:f1}).\relax }{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Relative change against \textsc  {Freq}\xspace  with 95\% paired-bootstrap CIs; positive means better, so BPB\xspace  changes are sign-flipped. The language-modeling gaps (left two groups) are large and have tight intervals. The fine-tuning differences (right three groups) are small, and every interval covers zero.\relax }}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:relative}{{3}{8}{Relative change against \freq with 95\% paired-bootstrap CIs; positive means better, so \bpb changes are sign-flipped. The language-modeling gaps (left two groups) are large and have tight intervals. The fine-tuning differences (right three groups) are small, and every interval covers zero.\relax }{figure.caption.8}{}}
